# Analytics (Umami)
# Your Umami website ID (shown in your Umami instance or Umami Cloud).
# Leave blank to disable analytics entirely — no events will be sent.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Where the Umami script is loaded from.
# Use your own instance or Umami Cloud, e.g. https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
# Set to "true" to also send events in development and from localhost.
# Leave unset/false for production behaviour (nothing is sent from dev/localhost).
NEXT_PUBLIC_UMAMI_ENABLE_DEV=false

# API
NEXT_PUBLIC_API_BASE=http://localhost:4000/api

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENCRYPTION_KEY=

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_SECRET=

# YouTube player
NEXT_PUBLIC_YOUTUBE_PLAYER_ORIGIN=
