      "name": "Public Properties",
      "item": [
        {
          "name": "Get All Public Properties",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/web/public/properties",
              "host": ["{{baseUrl}}"],
              "path": ["web", "public", "properties"]
            }
          }
        },
        {
          "name": "Get Featured Properties",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/web/public/properties/featured",
