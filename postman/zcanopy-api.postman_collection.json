        {
          "name": "Get Property Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/web/public/properties/{{propertyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["web", "public", "properties", "{{propertyId}}"]
            }
          }
        },
        {
          "name": "Search Properties",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/web/public/search?q={{query}}",
              "host": ["{{baseUrl}}"],
              "path": ["web", "public", "search"],
              "query": [
                {
                  "key": "q",
                  "value": "{{query}}"
                }
              ]
            }
          }
        }
      ]
    },
